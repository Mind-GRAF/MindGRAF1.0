  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "NetworkUI",
      "request": "launch",
      "mainClass": "edu.guc.mind_graf.view.NetworkUI",
      "projectName": "mindGRAF"
    },
    {
      "type": "java",
      "name": "CLI",
      "request": "launch",
      "mainClass": "edu.guc.mind_graf.parser.CLI",
      "projectName": "mindGRAF"
    },
    {
      "type": "java",
      "name": "ApiServer",
      "request": "launch",
      "mainClass": "edu.guc.mind_graf.api.ApiServer",
      "projectName": "mindGRAF"
    },
    {
      "type": "java",
      "name": "Current File",
      "request": "launch",
      "mainClass": "${file}"
    }
  ]
}
